# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for authentication — minimum 32 random characters in production
JWT_SECRET=replace-with-a-random-secret

# Comma-separated browser origins allowed in production, for example:
# CORS_ORIGIN=https://visionhub.example.com
CORS_ORIGIN=

# Persistent runtime paths (Render/Docker can mount /data)
DB_PATH=./server/visionhub.db
UPLOAD_PATH=./public/uploads

# Required for production setup; never use the development defaults.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
# Optional: set CREATE_DEFAULT_USER=true only when a separate test account is required.
CREATE_DEFAULT_USER=false
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=

# Google Gemini AI Configuration (optional; configure in deployment secrets)
# Get a new key from the provider console; never commit it.
GEMINI_API_KEY=

# Upload and backup settings
UPLOAD_MAX_SIZE=52428800
VIDEO_COMPRESSION_ENABLED=false
BACKUP_PATH=./backups
BACKUP_SCHEDULE=
