    "eslint": "^10.6.0",
    "eslint-plugin-jest": "^29.15.4",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.16",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "terser": "^5.44.0"
