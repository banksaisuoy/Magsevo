{
  "name": "visionhub-video-cms",
  "version": "1.0.0",
  "description": "A complete video content management system with admin panel",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "setup": "node server/setup.js",
    "test": "jest",
    "build:css": "npx tailwindcss -i ./input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./input.css -o ./public/css/tailwind.css --watch"
  },
  "keywords": [
    "video",
    "cms",
    "admin",
    "express",
    "sqlite",
    "content-management"
  ],
  "author": "VisionHub Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@ngrok/ngrok": "^1.5.2",
    "axios": "^1.12.0",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "fluent-ffmpeg": "^2.1.3",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "playwright": "^1.61.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
